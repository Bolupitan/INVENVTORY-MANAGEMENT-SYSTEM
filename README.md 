## 🗃️ Database Schema

### Entity Relationship Diagram
```
┌─────────────┐         ┌──────────────┐         ┌─────────────┐
│  Category   │◄────────│   Product    │────────►│  Supplier   │
│             │  1:N    │              │  N:1    │             │
│ id          │         │ id           │         │ id          │
│ name        │         │ name         │         │ name        │
│ description │         │ sku          │         │ contact     │
└─────────────┘         │ price        │         │ email       │
                        │ quantity     │         │ phone       │
                        │ category_id  │         └─────────────┘
                        │ supplier_id  │
                        └──────────────┘
                               │
                    ┌──────────┴──────────┐
                    │                     │
            ┌───────▼────────┐    ┌──────▼────────┐
            │ IncomingOrder  │    │ OutgoingOrder │
            │                │    │               │
            │ id             │    │ id            │
            │ supplier_id    │    │ customer_id   │
            │ order_date     │    │ order_date    │
            │ status         │    │ status        │
            └────────────────┘    └───────────────┘
                    │                     │
            ┌───────▼────────┐    ┌──────▼────────┐
            │IncomingOrderItem│   │OutgoingOrderItem│
            │                │    │               │
            │ id             │    │ id            │
            │ order_id       │    │ order_id      │
            │ product_id     │    │ product_id    │
            │ quantity       │    │ quantity      │
            │ unit_price     │    │ unit_price    │
            └────────────────┘    └───────────────┘
                    │                     │
                    └──────────┬──────────┘
                               │
                        ┌──────▼────────┐
                        │   Customer    │
                        │               │
                        │ id            │
                        │ name          │
                        │ email         │
                        │ phone         │
                        │ address       │
                        └───────────────┘
```

### Database Tables

#### products
```sql
CREATE TABLE products (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    description TEXT,
    sku VARCHAR(100) UNIQUE NOT NULL,
    price DECIMAL(10,2) NOT NULL,
    quantity INT NOT NULL DEFAULT 0,
    reorder_level INT DEFAULT 10,
    category_id BIGINT,
    supplier_id BIGINT,
    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL,
    FOREIGN KEY (category_id) REFERENCES categories(id),
    FOREIGN KEY (supplier_id) REFERENCES suppliers(id)
);
```

#### categories
```sql
CREATE TABLE categories (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL UNIQUE,
    description TEXT,
    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL
);
```

#### suppliers
```sql
CREATE TABLE suppliers (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    contact_person VARCHAR(255),
    email VARCHAR(255),
    phone VARCHAR(50),
    address TEXT,
    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL
);
```

#### customers
```sql
CREATE TABLE customers (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE,
    phone VARCHAR(50),
    address TEXT,
    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL
);
```

#### incoming_orders
```sql
CREATE TABLE incoming_orders (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    supplier_id BIGINT NOT NULL,
    order_date DATE NOT NULL,
    expected_delivery DATE,
    actual_delivery DATE,
    status VARCHAR(50) NOT NULL, -- PENDING, RECEIVED, CANCELLED
    notes TEXT,
    total_amount DECIMAL(10,2),
    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL,
    FOREIGN KEY (supplier_id) REFERENCES suppliers(id)
);
```

#### incoming_order_items
```sql
CREATE TABLE incoming_order_items (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    order_id BIGINT NOT NULL,
    product_id BIGINT NOT NULL,
    quantity INT NOT NULL,
    unit_price DECIMAL(10,2) NOT NULL,
    created_at DATETIME NOT NULL,
    FOREIGN KEY (order_id) REFERENCES incoming_orders(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id)
);
```

#### outgoing_orders
```sql
CREATE TABLE outgoing_orders (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    customer_id BIGINT NOT NULL,
    order_date DATE NOT NULL,
    shipping_date DATE,
    status VARCHAR(50) NOT NULL, -- PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
    notes TEXT,
    total_amount DECIMAL(10,2),
    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL,
    FOREIGN KEY (customer_id) REFERENCES customers(id)
);
```

#### outgoing_order_items
```sql
CREATE TABLE outgoing_order_items (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    order_id BIGINT NOT NULL,
    product_id BIGINT NOT NULL,
    quantity INT NOT NULL,
    unit_price DECIMAL(10,2) NOT NULL,
    created_at DATETIME NOT NULL,
    FOREIGN KEY (order_id) REFERENCES outgoing_orders(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id)
);
```

